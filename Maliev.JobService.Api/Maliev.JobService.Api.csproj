<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<UserSecretsId>maliev-jobservice-api</UserSecretsId>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<OpenApiGenerateDocuments>true</OpenApiGenerateDocuments>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<SharedLibraryVersion Condition="'$(SharedLibraryVersion)' == ''">1.0.*-*</SharedLibraryVersion>
	</PropertyGroup>

<ItemGroup>
		<ProjectReference Include="..\Maliev.JobService.Application\Maliev.JobService.Application.csproj" />
		<ProjectReference Include="..\Maliev.JobService.Infrastructure\Maliev.JobService.Infrastructure.csproj" />
	</ItemGroup>

	<ItemGroup Condition="'$(GITHUB_ACTIONS)' != 'true'">
		<ProjectReference Include="..\..\Maliev.Aspire\Maliev.Aspire.ServiceDefaults\Maliev.Aspire.ServiceDefaults.csproj" />
		<ProjectReference Include="..\..\Maliev.MessagingContracts\generated\csharp\Maliev.MessagingContracts.csproj" />
	</ItemGroup>

	<ItemGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
		<PackageReference Include="Maliev.Aspire.ServiceDefaults" Version="$(SharedLibraryVersion)" />
		<PackageReference Include="Maliev.MessagingContracts" Version="$(SharedLibraryVersion)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="MassTransit.EntityFrameworkCore" Version="[8.5.8, 9.0.0)" />
	</ItemGroup>

</Project>
