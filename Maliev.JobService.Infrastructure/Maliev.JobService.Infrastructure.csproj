<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<SharedLibraryVersion Condition="'$(SharedLibraryVersion)' == ''">1.0.*-*</SharedLibraryVersion>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Maliev.JobService.Application\Maliev.JobService.Application.csproj" />
		<ProjectReference Include="..\Maliev.JobService.Domain\Maliev.JobService.Domain.csproj" />
	</ItemGroup>

	<ItemGroup Condition="'$(GITHUB_ACTIONS)' != 'true'">
		<ProjectReference Include="..\..\Maliev.Aspire\Maliev.Aspire.ServiceDefaults\Maliev.Aspire.ServiceDefaults.csproj" />
	</ItemGroup>

	<ItemGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
		<PackageReference Include="Maliev.Aspire.ServiceDefaults" Version="$(SharedLibraryVersion)" />
	</ItemGroup>

</Project>
